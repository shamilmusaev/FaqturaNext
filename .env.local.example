NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste anon key from supabase start>
SUPABASE_SERVICE_ROLE_KEY=<paste service role key>
SUPABASE_PROJECT_REF=local

# AI features (Magic Fill, text polish). Without it the AI endpoints return
# "not configured" and the buttons surface a friendly error.
OPENAI_API_KEY=<paste OpenAI API key>
